RewriteEngine On

# A trailing slash is a different URL for the same page, so canonicalise it rather than answer
# both. The two halves of the problem look different and have one cause:
#
#   /category/development/  is a 404, because `?` in the route matches exactly one segment and
#                           the empty segment after the slash makes three where two were wanted.
#   /a-post/                is a 200, swallowed by the `/*` catch-all - which is worse, because
#                           it is the same page at two URLs with nothing naming the real one.
#
# WordPress wrote trailing slashes, so anything migrating from it has them in Google's index and
# in other people's links. This runs before the front controller and before PHP starts, so the
# redirect costs no boot at all.
#
# `%{REQUEST_URI}` rather than the rule pattern: it is the whole path from the server root, so
# this is correct both at a document root and under a subdirectory (a local /project/public).
# Real directories are skipped - Apache's own DirectorySlash owns those.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+?)/+$
RewriteRule ^ %1 [R=301,L,QSA]

# Everything that is not a real file or directory goes to the front controller.
# The router reads the path from the `route` parameter, so the rewrite has to pass it on.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=/$1 [QSA,L]

# --- Compression ---
#
# Nothing was compressed before this: the front page went out as 22 KB where it gzips to 5, and
# the stylesheet as 45 KB where it gzips to 14. That is ~48 KB off a first visit for a directive,
# with no build step and nothing to keep in step - which is why it is here rather than a minifier
# in front of the CSS. A minified stylesheet would also cost the comments, and this file is
# commented on purpose.
#
# **By type, never by default.** A jpeg, a png and a woff2 are already compressed; running them
# through DEFLATE spends CPU to make them very slightly bigger.
#
# Only DEFLATE, not BROTLI as well: with both filters on the same content Apache runs the output
# through both, and the second pass is compressing an already-compressed stream. Brotli is worth
# maybe another tenth on top of this, and it belongs in the vhost as a replacement rather than
# here as an addition.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- How long a static file may be kept ---
#
# The theme's own assets are served by PHP and already say `immutable` for a year; this is for
# the files Apache hands over itself, which said nothing at all - so every upload was refetched
# or revalidated on every visit.
#
# **A month for an upload, not a year.** An upload's URL never changes content, because the
# suffix is random per file - but `dpress media:regenerate` rewrites the *derivatives* in place
# when a preset changes, and a year would leave the old thumbnail in every cache that has one,
# with no way to reach it. A month is the trade: still far better than nothing, and a preset
# change is visible to everybody within weeks rather than never.
#
# Fonts and the like keep the year, because they change by being replaced under a new name.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|mp4|webm|mp3|m4a|pdf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
