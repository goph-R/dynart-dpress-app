<?php // The brand, whatever the site put in `social`, and the menu bar under it ?>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="<?= esc_attr(route_url('/')) ?>">
            <?php if (!empty($site_logo)): ?>
                <img src="<?= esc_attr($site_logo) ?>" alt="<?= esc_attr($site_name ?? '') ?>">
            <?php endif ?>
            <span>
                <span class="site-title"><?= esc_html($site_name ?? '') ?></span>
                <?php if ($site_description !== ''): ?>
                    <span class="site-description"><?= esc_html($site_description) ?></span>
                <?php endif ?>
            </span>
        </a>
        <span class="spacer"></span>
        <?php // the marks and the account links share a column at the right, one under the
              // other: they are two different things, and side by side they read as one row
              // of six links while taking the width the brand wants ?>
        <div class="header-aside">
            <?php // a place of its own, so the GitHub / YouTube links are a menu somebody edits
                  // rather than markup somebody has to open a template to change ?>
            <div class="site-social"><?= $places->render('social') ?></div>
            <?php // the `|` between these is drawn in CSS, by the rule that puts one before
                  // every item that has one before it - so a single link never gets one, and
                  // adding a third needs no template change ?>
            <div class="site-account">
                <?php if (!empty($current_user)): ?>
                    <a href="<?= esc_attr(route_url('/profile')) ?>"><?= esc_html($current_user->name() ?: 'Profile') ?></a>
                    <?php // a form and not a link, because `/logout` is POST only: a link that
                          // ends a session can be followed by a prefetcher, a crawler or an
                          // `<img>` somebody planted on another page, and the visitor is
                          // simply signed out ?>
                    <form class="logout" method="post" action="<?= esc_attr(route_url('/logout')) ?>">
                        <button type="submit">Log out</button>
                    </form>
                <?php else: ?>
                    <a href="<?= esc_attr(route_url('/login')) ?>">Log in</a>
                    <?php if (!empty($registration_open)): ?>
                        <a href="<?= esc_attr(route_url('/register')) ?>">Register</a>
                    <?php endif ?>
                <?php endif ?>
            </div>
        </div>
    </div>
</header>
<?php if (($main_menu ?? '') !== ''): ?>
    <nav class="site-nav"><div class="container"><?= $main_menu ?></div></nav>
<?php endif ?>
