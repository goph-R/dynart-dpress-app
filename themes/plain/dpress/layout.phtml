<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= esc_html(($title ?? '').($title ?? '' ? ' – ' : '').($site_name ?? '')) ?></title>
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body { margin: 0; font: 16px/1.7 Georgia, "Times New Roman", serif; background: #fffdf8; color: #2b2b2b; }
        header { border-bottom: 3px double #d8cfc0; padding: 22px 20px; }
        .bar { max-width: 700px; margin: 0 auto; display: flex; align-items: baseline; gap: 18px; }
        .bar a { color: #2b2b2b; text-decoration: none; }
        .bar .site { font-size: 22px; font-weight: 700; letter-spacing: -.5px; }
        .spacer { flex: 1; }
        .menu { list-style: none; display: flex; gap: 14px; margin: 0; padding: 0; }
        .menu .menu { display: none; }
        main { max-width: 700px; margin: 34px auto; padding: 0 20px; }
        h1 { font-size: 27px; margin: 0 0 18px; }
        .post-summary { padding-bottom: 22px; margin-bottom: 22px; border-bottom: 1px dotted #d8cfc0; }
        .post-summary h2 { font-size: 20px; margin: 0 0 4px; }
        .post-summary h2 a, .breadcrumb a, .meta a { color: #7a5c3e; }
        .meta, .breadcrumb { color: #8a8175; font-size: 14px; }
        .tag { display: inline-block; border: 1px solid #d8cfc0; border-radius: 3px; padding: 2px 9px;
               font-size: 13px; text-decoration: none; color: #7a5c3e; margin: 0 4px 4px 0; }
        /* nothing in a document may be wider than the column it is in */
        img, video { max-width: 100%; height: auto; }
        /* an iframe has no intrinsic shape, so it needs one told to it rather than kept */
        .dpress-embed { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; display: block; }
        .attachments { list-style: none; padding: 0; }
        .attachments li { display: flex; align-items: center; gap: 10px; padding: 5px 0; }
        .attachment-icon svg { width: 22px; height: 22px; color: #8a8175; display: block; }
        input[type=text], input[type=password] { width: 100%; padding: 9px; border: 1px solid #d8cfc0;
                                                 font: inherit; background: #fff; }
        .form-field { margin-bottom: 15px; }
        .form-field label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 4px; }
        .form-errors { border: 1px solid #c88; background: #fdf3f3; padding: 10px 14px; list-style: none; }
        button.primary { background: #7a5c3e; color: #fff; border: 0; padding: 10px 20px; font: inherit; cursor: pointer; }
        footer { border-top: 1px dotted #d8cfc0; margin-top: 40px; padding: 18px 20px; }
        footer .bar { font-size: 14px; color: #8a8175; }
        @media (prefers-color-scheme: dark) {
            body { background: #1c1a17; color: #e8e2d8; }
            .bar a, .bar .site { color: #e8e2d8; }
            input[type=text], input[type=password] { background: #262320; border-color: #4a443c; color: inherit; }
        }
    </style>
</head>
<body>
<header>
    <div class="bar">
        <a class="site" href="<?= esc_attr(route_url('/')) ?>"><?= esc_html($site_name ?? '') ?></a>
        <?= $main_menu ?? '' ?>
        <span class="spacer"></span>
        <?php if (!empty($current_user)): ?>
            <a href="<?= esc_attr(route_url('/profile')) ?>"><?= esc_html($current_user->name() ?: 'Profile') ?></a>
        <?php else: ?>
            <a href="<?= esc_attr(route_url('/login')) ?>">Log in</a>
        <?php endif ?>
    </div>
</header>
<main><?= $this->block('content') ?></main>
<footer><div class="bar"><?= $footer_menu ?? '' ?><span class="spacer"></span><?= esc_html($site_name ?? '') ?></div></footer>
</body>
</html>
