<html lang="en">
<head>
<?= $this->fetch('theme:partial/head', ['title' => $title ?? '']) ?>
</head>
<body class="<?= esc_attr($layout_kind ?? '') ?>">
<?= $this->fetch('theme:partial/chrome', ['part' => 'header']) ?>
<main>
    <?= $places->render('home_top') ?>
    <?= $this->block('content') ?>
</main>
<?= $this->fetch('theme:partial/chrome', ['part' => 'footer']) ?>
</body>
</html>
